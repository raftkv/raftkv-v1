# D2-batch1 部署配置文件（示例）
# 用法: 复制本文件为 deploy.env 并填入真实值
# deploy.env 不入git（已gitignore）

# 镜像名
IMAGE_NAME=raftkv-v26:ci-knife

# 指纹锚
FP_ANCHOR=raftkv-v25-test

# 端口（容器内）
GRPC_PORT=9500
HTTP_PORT=9000

# License目录（绝对路径，不入git）
# Windows示例: C:/Users/USERNAME/.raftkv/licenses
# Linux示例:  /opt/raftkv/licenses
LICENSE_DIR=__SET_YOUR_LICENSE_DIR__

# SM4密钥（修正A双模式）
# 留空 = 首次deploy_up自动生成并写入本地密钥文件(.sm4_key, gitignored)，后续复用
# 显式指定 = 使用指定值
SM4_KEY=