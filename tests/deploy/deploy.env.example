# =========================================================================
# RaftKV 部署配置文件（示例模板）
#
# 用法:
#   cp deploy.env.example deploy.env
#   # 编辑 deploy.env 填入真实值
#   docker compose -p deploy5 -f docker-compose-5node.yml \
#     -f docker-compose-5node-ports.yml --env-file deploy.env up -d
#
# 注意: deploy.env 不入 git（已 gitignore），本文件为公开模板。
# =========================================================================

# ---------------------------------------------------------------------------
# 镜像配置
# ---------------------------------------------------------------------------
# Docker 镜像名:标签（全仓库统一）
IMAGE_NAME=raftkit-gateway:v1

# ---------------------------------------------------------------------------
# 集群网络配置
# ---------------------------------------------------------------------------
# gRPC 端口（容器内部端口，外部映射见 docker-compose-5node-ports.yml）
GRPC_PORT=9500

# HTTP 端口（容器内部端口，外部映射见 docker-compose-5node-ports.yml）
HTTP_PORT=9000

# ---------------------------------------------------------------------------
# 加密配置
# ---------------------------------------------------------------------------
# SM4 国密对称密钥（16 字节，hex 编码 = 32 个十六进制字符）
# 生成方式: openssl rand -hex 16
# 注意: 此密钥用于 WAL 数据加密，集群内所有节点必须使用相同密钥。
#       生产环境请妥善保管，切勿提交到 git。
SM4_KEY=__GENERATE_WITH_openssl_rand_hex_16__

# ---------------------------------------------------------------------------
# 授权配置
# ---------------------------------------------------------------------------
# 授权文件目录（绝对路径，存放 node-1.key ~ node-5.key）
# 生成方式: 参考 README.md "授权文件生成" 章节
# Windows 示例: C:/Users/USERNAME/.raftkv/licenses
# Linux   示例: /opt/raftkv/licenses
LICENSE_DIR=__SET_YOUR_LICENSE_DIR__

# 授权失败处理模式:
#   closed = 授权校验失败即拒绝启动（Fail-Closed，出厂默认，生产环境唯一安全值）
#   open   = 授权校验失败降级为只读运行（Fail-Open，仅限评估/演示）
# 详见 README.md "授权模式" 章节
LICENSE_FAIL_MODE=closed

# 指纹锚点（用于容器环境硬件指纹稳定化）
# 设置为宿主机唯一标识（主机名 / K8s Node 名称 / 固定 UUID）
# 生成方式: uuidgen 或 cat /etc/machine-id
FP_ANCHOR=__SET_YOUR_FINGERPRINT_ANCHOR__

# ---------------------------------------------------------------------------
# WAL 持久化配置
# ---------------------------------------------------------------------------
# WAL 文件路径（容器内路径，每个节点独立）
# 已在 docker-compose 中通过命名卷挂载到 /app/wal-data
# 如需修改，请同步更新 compose 文件中的 volumes 挂载
WAL_PATH=/app/wal-data/raft.wal