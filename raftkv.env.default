# =========================================================================
# RaftKV 确定性管控中枢 — 默认交付环境变量模板
#
# 文件性质：出厂默认交付模板（权威）。所有客户交付环境以此文件为基线。
# 生效日期：2026-09-01（姜总裁决二）
#
# 使用方式：
#   Docker Compose : environment 段逐项引用，或 env_file: - raftkv.env.default
#   systemd        : EnvironmentFile=<绝对路径>/raftkv.env.default
#   裸机 / 容器    : export $(grep -v '^#' raftkv.env.default | xargs)
#
# ⚠ 法务红线：
#   LICENSE_FAIL_MODE 出厂值恒为 closed。
#   在甲方签署并生效《授权到期降级只读补充条款》之前，
#   严禁将本值改为 open —— 否则构成对主合同免责条款的实质性违反。
# =========================================================================

# ------------------------------------------------------------------
# 双模式授权防线（2026-09-01 姜总裁决二）
# ------------------------------------------------------------------
# closed（出厂默认，唯一安全值）
#     授权校验失败（无 license.key / 签名无效 / 硬件指纹不匹配 /
#     时间回拨 / 授权过期）时，进程 log.Fatal 立即终止，拒绝启动。
#     语义：Fail-Closed —— 无有效授权则系统不运行。
#
# open（受限启用）
#     授权校验失败时，系统降级为只读模式继续运行：
#       允许：Raft 选举、心跳、只读查询、健康检查、日志复制
#       拒绝：所有写入请求、集群成员变更（/cluster/add、/cluster/remove）
#     启用前置条件（三者缺一不可）：
#       1. 甲方已签署《授权到期降级只读补充条款》且条款已生效
#       2. 主合同免责条款已同步修订为"降级只读"表述
#       3. 经RaftKV 授权管理人书面确认
LICENSE_FAIL_MODE=closed

# ------------------------------------------------------------------
# 基础运行参数
# ------------------------------------------------------------------
NODE_ID=node-1
GRPC_PORT=9500
HTTP_PORT=9000
HTTP_BIND=127.0.0.1

# Peer 列表：生产环境必须使用容器名或内网 DNS，禁止使用 localhost
# PEERS=node-2=raftkv-node-2:9501,node-3=raftkv-node-3:9502

# ------------------------------------------------------------------
# 运维自证端点（只读，可安全暴露给甲方审计）
# ------------------------------------------------------------------
#   GET /license/status   返回当前 fail_mode / degraded / degraded_reason
#   GET /health/live      存活探针
#   GET /health/ready     就绪探针
